# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# User inputs and dropped mods (keep .gitkeep only)
input/*
!input/.gitkeep

# Output exports and generated mods (keep .gitkeep only)
output/*
!output/.gitkeep

# System & IDE files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.log
